{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ESNext", "DOM"],
    "skipLibCheck": true,
    "outDir": "../packages/core/basic/dist",
    "rootDir": "../packages/core/basic",
    "baseUrl": ".",
    "paths": {
      "*": ["node_modules/*"]
    },
    "typeRoots": ["node_modules/@types"],
    "esModuleInterop": true
  },
  "include": ["../packages/core/basic/src/**/*"],
  "exclude": ["node_modules"]
}
